# Customer website — copy to .env.local. NEXT_PUBLIC_* values are visible to browsers (not secrets).
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_AGENTS_URL=http://localhost:8100
# Server-side rendering may use an internal URL (e.g. Cloud Run service URL)
API_URL=http://localhost:8000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Firebase web config (from Firebase console → Project settings). Demo values work with the emulators.
NEXT_PUBLIC_FIREBASE_API_KEY=demo-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=demo-gudmeal.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-gudmeal
NEXT_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:demo
NEXT_PUBLIC_USE_FIREBASE_EMULATORS=true

# Optional Maps JavaScript API key for map tiles (restrict it to your domains; see docs/GOOGLE_MAPS.md).
# Without it maps are schematic previews. Address search goes through the API and never needs it.
# NEXT_PUBLIC_GOOGLE_MAPS_BROWSER_KEY=
