# gudmeal-agents — copy to .env for local development. Never commit real keys (the repo is public).

ENVIRONMENT=local
API_BASE_URL=http://localhost:8000
FIREBASE_PROJECT_ID=demo-gudmeal
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099

# Gemini (Google AI Studio key). Without a key the service runs in a safe degraded mode.
# GOOGLE_API_KEY=
GEMINI_MODEL=gemini-flash-latest        # pin a stable id in staging/production (scripts/check_gemini_models.py)
# GEMINI_FALLBACK_MODEL=
PRICE_INPUT_PER_MILLION_USD=0.30         # update from the current Gemini price list
PRICE_OUTPUT_PER_MILLION_USD=2.50

# Persistence
CHECKPOINTER=sqlite                     # memory | sqlite | postgres
CHECKPOINT_SQLITE_PATH=./agents_checkpoints.sqlite
# CHECKPOINT_POSTGRES_URL=postgresql://gudmeal_agents:<password>@127.0.0.1:5432/gudmeal_agents
DATABASE_URL=sqlite+aiosqlite:///./gudmeal_agents.db

# Observability (optional)
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=gudmeal-agents-dev
