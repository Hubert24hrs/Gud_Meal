# gudmeal-api — copy to .env for local development. Never commit real secrets (the repo is public).
# In staging/production every secret comes from Secret Manager via Cloud Run env bindings.

ENVIRONMENT=local                  # local | test | development | staging | production
LOG_LEVEL=INFO
PUBLIC_BASE_URL=http://localhost:8000
CORS_ORIGINS=["http://localhost:3000","http://localhost:3001","http://localhost:3002"]

# --- data -------------------------------------------------------------------------------------
DATA_BACKEND=memory                # memory (offline demo data) | firestore (emulator or GCP)
SEED_DEMO_DATA=true                # memory backend only
GCP_PROJECT_ID=demo-gudmeal
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
DATABASE_URL=sqlite+aiosqlite:///./gudmeal_local.db
# DATABASE_URL=postgresql+asyncpg://gudmeal:<password>@127.0.0.1:5432/gudmeal

# --- auth -------------------------------------------------------------------------------------
FIREBASE_PROJECT_ID=demo-gudmeal
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
APP_CHECK_ENFORCED=false

# --- payments (sandbox keys only outside production) ---------------------------------------------
PAYMENT_DEFAULT_PROVIDER=paystack  # falls back to the local sandbox when no keys are configured
PAYMENT_CALLBACK_URL=http://localhost:3000/checkout/callback
# PAYSTACK_SECRET_KEY=sk_test_xxx
# PAYSTACK_WEBHOOK_IP_ALLOWLIST=["52.31.139.75","52.49.173.169","52.214.14.220"]
# FLUTTERWAVE_SECRET_KEY=FLWSECK_TEST-xxx
# FLUTTERWAVE_SECRET_HASH=choose-a-long-random-string
REFUND_AUTO_APPROVE_LIMIT_KOBO=0

# --- internal endpoints ---------------------------------------------------------------------------
INTERNAL_AUTH_MODE=shared_secret   # oidc in staging/production
INTERNAL_SHARED_SECRET=change-me-local-only
# INTERNAL_OIDC_AUDIENCE=https://gudmeal-api-xxxx.a.run.app
# INTERNAL_OIDC_SERVICE_ACCOUNTS=["gudmeal-tasks@gud-meal-dev.iam.gserviceaccount.com"]

# --- async infrastructure -------------------------------------------------------------------------
EVENT_BUS=inprocess                # pubsub in cloud
TASK_QUEUE=inprocess               # cloudtasks in cloud
# PUBSUB_TOPIC=gudmeal-domain-events
# CLOUD_TASKS_LOCATION=europe-west1
# CLOUD_TASKS_QUEUE=gudmeal-default
# CLOUD_TASKS_SERVICE_ACCOUNT=gudmeal-tasks@gud-meal-dev.iam.gserviceaccount.com
NOTIFIER=log                       # fcm in cloud

# --- maps (Google Maps Platform, see docs/GOOGLE_MAPS.md) -------------------------------------------
# Server key for Places API (New), Geocoding API and Routes API. Never put it in an app or website.
# Unset = neighbourhood table + straight-line estimates, labelled as estimates (no Google calls, no cost).
# GOOGLE_MAPS_API_KEY=
MAPS_TRAVEL_MODE=DRIVE               # DRIVE | TWO_WHEELER
MAPS_TRAFFIC_AWARE=true              # true = better ETAs at Google's Pro Routes rate; false = Essentials rate
MAPS_ROUTES_ENABLED=true             # false = never call the Routes API
MAPS_LIVE_ETA_REFRESH_SECONDS=180    # live delivery ETA re-measured at most this often
MAPS_DAILY_REQUEST_CAP=20000         # per API instance; GCP quotas and a billing budget are the hard limit
MAPS_TIMEOUT_SECONDS=4
